{
  "name": "OSCAR-Viewer",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prebuild": "npm run validate:dependencies && npm run validate:locales && node scripts/clean-build-output.js",
    "build": "next build --webpack",
    "postbuild": "node scripts/verify-mqtt-bundle.js",
    "audit:dependencies": "npm audit --audit-level=low",
    "validate:dependencies": "node scripts/verify-dependencies.js",
    "validate:locales": "node scripts/validate-locales.js",
    "start": "next start",
    "dev": "next dev --webpack",
    "lint": "tsc --noEmit --traceResolution false",
    "start-exported": "npx serve@latest web",
    "test": "cypress run --e2e --browser chrome",
    "test:all": "cypress run --e2e --browser chrome --headed --spec 'cypress/e2e/all-specs.cy.tsx'",
    "test:component": "cypress run --component --browser chrome",
    "test:map": "cypress run --component --browser chrome --spec 'cypress/component/MapUtils.cy.ts'",
    "test:discovery": "cypress run --component --browser chrome --spec 'cypress/component/LaneDiscovery.cy.ts'",
    "test:video": "cypress run --component --browser chrome --spec 'cypress/component/VideoStreamUtils.cy.ts,cypress/component/HLSVideoComponent.cy.tsx'",
    "test:adjudication": "cypress run --component --browser chrome --spec 'cypress/component/AdjudicationCommand.cy.ts'",
    "test:event-filter": "cypress run --component --browser chrome --spec 'cypress/component/EventFilter.cy.ts'",
    "test:event-lookup": "cypress run --component --browser chrome --spec 'cypress/component/EventLookup.cy.ts,cypress/component/RealtimeNotification.cy.ts'",
    "test:alarm-transfer": "cypress run --component --browser chrome --spec 'cypress/component/AlarmQrTransfer.cy.ts,cypress/component/AlarmExportIdentity.cy.tsx,cypress/component/AlarmTransferImport.cy.tsx'",
    "test:health": "cypress run --component --browser chrome --spec 'cypress/component/HealthPage.cy.tsx,cypress/component/DashboardLaneHealth.cy.tsx,cypress/component/LaneRealtimeSources.cy.ts'",
    "test:scheduled": "cypress run --e2e --browser chrome --spec 'cypress/e2e/DashboardPage.cy.tsx,cypress/e2e/EventDetailsPage.cy.tsx,cypress/e2e/EventDetailsLaneGuard.cy.tsx,cypress/e2e/EventLogPage.cy.tsx,cypress/e2e/LaneViewPage.cy.tsx,cypress/e2e/MapPage.cy.tsx,cypress/e2e/NationalViewPage.cy.tsx,cypress/e2e/ReportPage.cy.tsx'"
  },
  "keywords": [
    "OpenSensorHub",
    "osh-js",
    "Cesium"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-flow": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@cypress/vite-dev-server": "^8.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "cypress": "^16.2.0",
    "react-to-print": "^3.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "webpack": "^5.90.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@cesium/engine": "8.0.0",
    "@cesium/widgets": "5.0.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.0.13",
    "@fortawesome/free-brands-svg-icons": "^6.2.1",
    "@fortawesome/free-regular-svg-icons": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@mui/icons-material": "^5.10.14",
    "@mui/material": "^5.16.4",
    "@mui/styles": "^6.1.4",
    "@mui/x-data-grid": "^7.11.1",
    "@mui/x-date-pickers": "^7.20.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@types/react-dom": "^19.3.0",
    "@types/react-redux": "^7.1.24",
    "antd": "^5.21.4",
    "cesium": "^1.114.0",
    "chartjs-adapter-moment": "^1.0.1",
    "chartjs-plugin-annotation": "^3.0.1",
    "dayjs": "^1.11.13",
    "fflate": "^0.8.3",
    "flatted": "^3.3.3",
    "hls.js": "^1.6.13",
    "idb": "^7.1.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "nouislider": "^15.6.1",
    "ol": "^10.1.0",
    "ol-layerswitcher": "^4.1.2",
    "osh-js": "https://codeload.github.com/tyronechrisharris/osh-js/tar.gz/f48fa3e8de79a29fc64834b7166cd97ebf7d02eb",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.4.5",
    "react-redux": "^9.1.2",
    "redux-persist": "^5.10.0",
    "styled-components": "^5.3.6",
    "wnumb": "^1.2.0",
    "worker-loader": "^3.0.8"
  }
}
